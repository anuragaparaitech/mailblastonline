# Port Configuration (default: 3000)
PORT=3000

# MongoDB Atlas Cloud Database URI (Optional)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YourPassword123@cluster0.abcde.mongodb.net/mailblast?retryWrites=true&w=majority

# Local SQLite Database Path (Optional override)
# DB_PATH=./database/mailblast.db
